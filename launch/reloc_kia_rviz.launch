<launch>
<!-- WATCH kia (MID360) relocalization in rviz vs the UNIFIED (ext) map. Node + rviz +
     latched init pose. Then play the bag(s) in a SECOND terminal.
     init yaw = GT course (kia/livox body is X-forward). Override px/py/qz/qw on cmd line. -->
	<arg name="px" default="0.0" />
	<arg name="py" default="0.0" />
	<arg name="pz" default="0.0" />
	<arg name="qx" default="0.0" />
	<arg name="qy" default="0.0" />
	<arg name="qz" default="0.0" />
	<arg name="qw" default="1.0" />

	<rosparam command="load" file="$(find fastlio_localization)/config/mid360.yaml" />
	<rosparam command="load" file="$(find fastlio_localization)/config/localization_unified_honda.yaml" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="3"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.5" />
	<param name="filter_size_map" type="double" value="0.5" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
	<node pkg="fastlio_localization" type="fastlio_mapping" name="laserMapping" output="screen" />

	<group ns="backend">
		<param name="enable" value="true"/>
		<param name="min_local_points" value="1000"/>
		<param name="min_local_radius" value="20.0"/>
		<param name="min_frames" value="100"/>
		<param name="submap_radius" value="20.0"/>
		<param name="submap_voxel_size" value="0.3"/>
		<param name="update_interval" value="1"/>
		<param name="max_point2plane_dist" value="3"/>
		<param name="global_residual_weight" value="6"/>
		<param name="max_global_points" value="2000"/>
		<param name="continuous_align_enable" value="true"/>
		<param name="continuous_align_stride" value="1"/>
	</group>

	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
	      args="-d $(find fastlio_localization)/rviz_cfg/loam_livox2.rviz" />

	<param name="init_pose/position" value="$(arg px) $(arg py) $(arg pz)" />
	<param name="init_pose/orientation" value="$(arg qx) $(arg qy) $(arg qz) $(arg qw)" />
	<node pkg="fastlio_localization" type="publish_init_pose.py" name="init_pose_pub" output="screen" />
</launch>
